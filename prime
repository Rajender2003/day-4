def is_prime(n):
  if n <= 1:
    return False
  for i in range(2, int(n**0.5) + 1):
    if n % i == 0:
      return False
  return True

def sum_of_digits(n):
  s = str(n)
  d = [int(i) for i in s]
  return sum(d)

def all_digits_are_prime(n):
  if not isinstance(n, int) or n < 0:
        return False
  if n == 0:
      return is_prime(0)

  s = str(n)
  for digit_char in s:
    digit = int(digit_char)
    if not is_prime(digit):
      return False
  return True

print("--- Finding numbers between 100 and 999 where number, sum of digits, and all digits are prime ---")
for i in range(100, 1000):
  if is_prime(i) and is_prime(sum_of_digits(i)) and all_digits_are_prime(i):
    print(i)
